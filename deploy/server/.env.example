# Public Caddy site address.
# Use a real hostname for TLS, for example: RT_SERVER_SITE=timing.example.com
# Use http://localhost for a local smoke test without public TLS.
RT_SERVER_SITE=http://localhost

# Where Caddy can reach Authelia's forward-auth endpoint.
# If Authelia runs outside this Compose project, set this to a reachable URL.
AUTHELIA_UPSTREAM=http://authelia:9091

# Published host ports for Caddy.
HTTP_PORT=80
HTTPS_PORT=443

# Server image. For local builds, leave this as rt-server:latest and run
# `docker compose ... build server`; for release deploys use the pushed image.
SERVER_IMAGE=rt-server
SERVER_VERSION=latest
# Example release image:
# SERVER_IMAGE=iwismer/rt-server
# SERVER_VERSION=v0.1.0

# Server log verbosity.
LOG_LEVEL=info
